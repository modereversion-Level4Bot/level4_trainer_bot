# Environment and secrets
.env
.env.*
!.env.example
google_service_account.json
*service_account*.json
credentials.json
token.json

# Databases and backups
*.db
*.sqlite
*.sqlite3
backups/
secrets/

# Python cache and virtual environments
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.venv/
venv/

# Logs and archives
*.log
*.zip
exports/
*.media-assets-export.json
*.media-assets-export.b64

# Questions source audio (keep folder structure via .gitkeep if needed)
media/questions/**
!media/questions/
!media/questions/**/
!media/questions/**/.gitkeep

# Routes source media (local-only source files; keep folders via .gitkeep)
media/routes/**/*.mp3
media/routes/**/*.ogg
media/routes/**/*.wav
media/routes/**/*.m4a
media/routes/**/*.jpg
media/routes/**/*.jpeg
media/routes/**/*.png
media/routes/**/*.webp
!media/routes/**/.gitkeep

# Legacy local media folders (local-only; keep folder structure)
media/audio/**
!media/audio/
!media/audio/**/
!media/audio/**/.gitkeep

media/images/**
!media/images/
!media/images/**/
!media/images/**/.gitkeep

media/voice/**
!media/voice/
!media/voice/**/
!media/voice/**/.gitkeep
